# Rubbi frontend — public configuration only. Never put a secret or a private
# key in this file or in any NEXT_PUBLIC_* variable: everything here is
# bundled into the browser.

# Base URL of the Rubbi API (RL-api), including the /api/v1 prefix. The API
# must list this app's origin in its CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Optional overrides. When unset, the network, RPC URL, USDC SAC and contract
# ids are read from GET /stellar/config (the API is the source of truth).
# Public testnet ids from RL-smart-contracts/deployments/testnet.json:
#NEXT_PUBLIC_STELLAR_NETWORK=testnet
#NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
#NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
#NEXT_PUBLIC_USDC_SAC_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
#NEXT_PUBLIC_VAULT_CONTRACT_ID=CBGARSQ7BY4345DNX76LWT4VXEHRRFJMNW46SCX7DRHBILL5V6RJN6KR
#NEXT_PUBLIC_SUBSCRIPTIONS_CONTRACT_ID=CDWMLKAUMXHLSBOKKCK5A4ECUP2VIIHXAL7MVQ5TEFLE3QUXZRMDC3PC
#NEXT_PUBLIC_PAYROLL_CONTRACT_ID=CB76PQ2MTILAQJAHLMTRHYDODX7H73YUCTVVKYO46ME3MK6WUTELDGYU

# Circle's testnet USDC issuer (used to build the USDC trustline on testnet).
#NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
